{
	"name": "life-corpus",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=24 <25",
		"pnpm": ">=11 <12"
	},
	"scripts": {
		"dev": "concurrently --kill-others-on-fail --names emulators,web --prefix-colors magenta,cyan \"pnpm dev:emulators\" \"pnpm dev:web\"",
		"dev:web": "vite dev --host 127.0.0.1",
		"dev:emulators": "pnpm functions:build && firebase emulators:start --project demo-life-corpus",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test": "pnpm test:unit",
		"test:e2e": "playwright test",
		"test:rules": "firebase emulators:exec --only firestore --project demo-life-corpus \"pnpm vitest run tests/rules\"",
		"functions:build": "pnpm --dir functions build",
		"verify": "pnpm check && pnpm lint && pnpm test:unit && pnpm test:rules && pnpm functions:build && pnpm build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@firebase/rules-unit-testing": "^5.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"concurrently": "^10.0.3",
		"cross-env": "^10.1.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"firebase-tools": "^15.24.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@lucide/svelte": "^1.25.0",
		"@skeletonlabs/skeleton": "5.0.0",
		"@skeletonlabs/skeleton-svelte": "5.0.0",
		"firebase": "^12.16.0"
	}
}
