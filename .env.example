# Safe local defaults. Copy to .env only when overriding these values.
PUBLIC_USE_FIREBASE_EMULATORS=true
PUBLIC_FIREBASE_PROJECT_ID=demo-life-corpus
PUBLIC_FIREBASE_API_KEY=demo-api-key
PUBLIC_FIREBASE_APP_ID=1:1234567890:web:demo
PUBLIC_FIREBASE_AUTH_DOMAIN=demo-life-corpus.firebaseapp.com
PUBLIC_FIREBASE_STORAGE_BUCKET=demo-life-corpus.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
PUBLIC_FIREBASE_MEASUREMENT_ID=G-DEMO
PUBLIC_ENABLE_AI_DEV_TOOLS=true
PUBLIC_AI_PROVIDER=mock

# Firebase web configuration is public by design and is embedded in browser builds.
# Supply production values through an ignored local file or the build environment.
# Production only: replace every public Firebase value and set emulators to false.
# Gemini credentials never belong in this file; use Firebase Secret Manager.
